# ==============================================================================
# LIVOTEL PREMIUM HOTEL - PRIVATE BILLING APPLICATION
# Environment Configuration Example (DO NOT commit actual secrets to Git)
# ==============================================================================

# 1. Netlify Database (PostgreSQL powered by Neon)
# Automatically injected by Netlify when Netlify Database is provisioned (`npx netlify db init`).
# For local development against a Neon dev branch, set this in a local `.env` file.
# If omitted in local development (`NODE_ENV !== 'production'`), the app uses an isolated
# local embedded PostgreSQL instance in `.local-data/pgdata` so production data is never touched.
NETLIFY_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# 2. One-Time Primary Admin Bootstrap Secret
# Required ONLY once to create the very first Administrator account via `/login` -> "Initial Admin Bootstrap".
# Once an admin account exists in PostgreSQL, bootstrap is permanently disabled in the database.
# Generate with: `openssl rand -hex 32`
ADMIN_BOOTSTRAP_SECRET="replace-with-32-byte-random-hex-secret"

# 3. Primary Admin Emergency Recovery Secret (Optional)
# Used ONLY if the primary administrator loses their password and needs to trigger an emergency
# password reset via the server-side recovery endpoint or CLI script.
# Generate with: `openssl rand -hex 32`
ADMIN_RECOVERY_SECRET="replace-with-separate-32-byte-random-hex-secret"

# 4. Application Origin (Used for strict Origin / CSRF validation in production)
# Netlify automatically populates `URL` and `DEPLOY_PRIME_URL`, or you can set `APP_ORIGIN` explicitly.
APP_ORIGIN="http://localhost:5173"

# 5. Session Configuration
SESSION_TTL_HOURS="12"
